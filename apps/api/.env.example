PORT=5000
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Secret used to sign login tokens (JWTs). Use a long random string and never share it
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# Optional: websites allowed to connect to real-time events from another address (comma separated). Leave empty for same-site only
# CORS_ORIGIN="http://localhost:3000"

# Optional: Redis address for background jobs (leave unset to switch jobs off). Example for local Redis:
# REDIS_URL="redis://localhost:6379"
# Minutes to wait before checking that a new ticket got a first reply (default 15)
# SLA_FIRST_RESPONSE_MINUTES=15
# DEVELOPMENT ONLY: make the first N notification sends fail on purpose, to watch retries
# SIMULATE_NOTIFY_FAILURES=0

# REQUIRED for tests: a SEPARATE empty database whose name contains "test" (tests delete all data in it!)
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/support_desk_test"
# Failed logins (or sign-ups) one IP address may make per time window (default 10)
# AUTH_RATE_LIMIT_MAX=10
# Password hashing cost: each +1 doubles the time (default 12; keep 12 or higher in production)
# BCRYPT_ROUNDS=12
