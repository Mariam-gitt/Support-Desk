generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Organization roles
enum Role {
  OWNER
  ADMIN
  AGENT
}

// Ticket lifecycle
enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// Ticket urgency
enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MessageSenderType {
  STAFF
  CUSTOMER
}

// User login identity
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships     Membership[]
  messages        Message[]
  refreshTokens   RefreshToken[]
  sentInvitations Invitation[]   @relation("InvitationCreator")
}

// Business workspace
model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  memberships Membership[]
  customers   Customer[]
  tickets     Ticket[]
  invitations Invitation[]
}

// User's membership in an organization
model Membership {
  id             String @id @default(uuid())
  userId         String
  organizationId String
  role           Role

  user            User         @relation(fields: [userId], references: [id])
  organization    Organization @relation(fields: [organizationId], references: [id])
  assignedTickets Ticket[]

  @@unique([userId, organizationId])
  @@index([organizationId])
}

// Customer contact within an organization
model Customer {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  email          String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  tickets      Ticket[]
  messages     Message[]

  @@unique([organizationId, email])
  @@index([organizationId])
}

// Customer support ticket
model Ticket {
  id             String         @id @default(uuid())
  organizationId String
  customerId     String
  assignedToId   String?
  subject        String
  description    String
  status         TicketStatus   @default(OPEN)
  priority       TicketPriority @default(MEDIUM)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
  customer        Customer     @relation(fields: [customerId], references: [id])
  assignedTo      Membership?  @relation(fields: [assignedToId], references: [id])
  messages        Message[]
  publicTokenHash String?      @unique

  @@index([organizationId, status, createdAt])
  @@index([customerId, createdAt])
}

// Messages within a ticket
model Message {
  id         String            @id @default(uuid())
  ticketId   String
  senderId   String?
  customerId String?
  senderType MessageSenderType @default(STAFF)
  body       String
  createdAt  DateTime          @default(now())

  ticket   Ticket    @relation(fields: [ticketId], references: [id])
  sender   User?     @relation(fields: [senderId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Invitation {
  id             String    @id @default(uuid())
  organizationId String
  invitedById    String
  email          String
  role           Role
  tokenHash      String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationCreator", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
}
